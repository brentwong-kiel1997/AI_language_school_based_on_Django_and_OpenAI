# MiniMax China Token Plan — lesson generation + standalone minimax_cli / mmx
MINIMAX_API_KEY=
MINIMAX_REGION=cn
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MINIMAX_MUSIC_MODEL=music-2.6
MINIMAX_VISION_MODEL=MiniMax-VL
MINIMAX_CONTEXT_WINDOW_TOKENS=1000000
MINIMAX_MAX_TOKENS=131072
MINIMAX_TIMEOUT_SECONDS=300
MINIMAX_VIDEO_TIMEOUT_SECONDS=600
MINIMAX_POLL_INTERVAL_SECONDS=5
MINIMAX_OUTPUT_DIR=.
# Django Generator orchestration
MINIMAX_MAX_RETRIES=2
# Writer/Checker revision rounds per module (local schema + Checker agent)
MINIMAX_VALIDATION_RETRIES=1
# Parallel lesson modules (core/words/grammar/listening/expression/translation). 1 = sequential.
MINIMAX_MODULE_WORKERS=6
# Split vocabulary into N parallel batches (same dictionary quality; merge+dedupe). 1 = single call.
MINIMAX_WORDS_BATCHES=2
MINIMAX_AGENT_PROMPT_CHARS=18000
MINIMAX_AGENT_CHUNK_CHARS=6000
# MINIMAX_QUOTA_ENDPOINT=/v1/coding_plan/quota
# MINIMAX_SEARCH_ENDPOINT=/v1/coding_plan/search
# MINIMAX_VISION_ENDPOINT=/v1/coding_plan/vlm
# MINIMAX_CONFIG_DIR=~/.mmx

# YouTube anti-bot cookies (server-friendly — read from a file, never prompts for a password).
# RECOMMENDED for deploys: export cookies ONCE on a machine with a browser, upload the
# file, then point YOUTUBE_COOKIE_FILE at it. yt-dlp reads the plain text file directly,
# so no browser / no OS keychain is touched on the server.
#   1) On your laptop (logged into YouTube):  python manage.py youtube_cookies export --from-browser chrome cookies.txt
#   2) On the server:                          python manage.py youtube_cookies install cookies.txt
#   3) Verify:                                 python manage.py youtube_cookies check
# YOUTUBE_COOKIE_FILE=cookies/youtube.txt
#
# Local-dev only fallback (NOT for servers — reads a live browser profile and may
# prompt for a keychain password / hang if the browser is running):
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
