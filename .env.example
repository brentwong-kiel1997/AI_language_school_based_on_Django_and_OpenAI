# =============================================================================
# LLM — OpenAI-compatible Chat Completions (lesson generation ONLY)
# POST {LLM_BASE_URL}/chat/completions
# =============================================================================
# Examples:
#   MiniMax CN:   LLM_BASE_URL=https://api.minimax.cn/v1    LLM_MODEL=MiniMax-M3
#   MiniMax Global: LLM_BASE_URL=https://api.minimax.io/v1  LLM_MODEL=MiniMax-M3
#   OpenAI:       LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
#   DeepSeek:     LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   Local vLLM:   LLM_BASE_URL=http://127.0.0.1:8000/v1     LLM_MODEL=...
#
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.cn/v1
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=300
# Input context size in tokens (model capability). Used to size the local prompt
# budget before summarising long transcripts. MiniMax-M3 ≈ 1000000.
LLM_CONTEXT_WINDOW_TOKENS=1000000
# Output cap (MiniMax-M3 supports up to 131072 completion tokens).
LLM_MAX_TOKENS=131072
# prompt = inject "JSON only" system message (portable)
# response_format = send OpenAI response_format=json_object (not all providers accept it)
# off = no JSON hint
LLM_JSON_MODE=prompt

# Generator orchestration
LLM_MAX_RETRIES=2
LLM_VALIDATION_RETRIES=1
LLM_MODULE_WORKERS=6
LLM_WORDS_BATCHES=2
# Optional hard cap on prompt chars. If unset, derived from
# LLM_CONTEXT_WINDOW_TOKENS - LLM_MAX_TOKENS (≈ 2.1M chars at 1M / 131k).
# LLM_AGENT_PROMPT_CHARS=18000
LLM_AGENT_CHUNK_CHARS=100000

# Django
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# YouTube anti-bot cookies (server-friendly — read from a file, never prompts for a password).
# RECOMMENDED for deploys: export cookies ONCE on a machine with a browser, upload the
# file, then point YOUTUBE_COOKIE_FILE at it. yt-dlp reads the plain text file directly,
# so no browser / no OS keychain is touched on the server.
#   1) On your laptop (logged into YouTube):  python manage.py youtube_cookies export --from-browser chrome cookies.txt
#   2) On the server:                          python manage.py youtube_cookies install cookies.txt
#   3) Verify:                                 python manage.py youtube_cookies check
# YOUTUBE_COOKIE_FILE=cookies/youtube.txt
#
# Local-dev only fallback (NOT for servers — reads a live browser profile and may
# prompt for a keychain password / hang if the browser is running):
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
